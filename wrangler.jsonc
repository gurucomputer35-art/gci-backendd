{
  // One Cloudflare Worker: files in ./public are served directly; /api/*, the website pages and /sitemap.xml run src/index.js.
  "name": "guru-computer-institute",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    "SITE_URL": "https://www.gurucomputerinstitute.com",
    "MONGODB_DB": "GuruComputerWebsite",
    "MAIL_FROM_NAME": "Guru Computer Institute",
    "STUDENT_ID_PREFIX": "GCI2022"
  }
  // Secrets are added in the Cloudflare dashboard (Settings > Variables and Secrets), never in this file.
  // See .env.example for the full list.
}
