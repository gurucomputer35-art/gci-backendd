# Guru Computer Institute: settings the website needs.
# On Cloudflare: add each line in Workers > your Worker > Settings > Variables and Secrets (type "Secret" for secrets).
# For local testing with `npx wrangler dev`: copy this file to `.dev.vars` and fill in values. Never commit real values.

# ---------- required ----------
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Use a user with readWrite on GuruComputerWebsite only.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
# Long random text, at least 32 characters. Signs login sessions. Changing it logs everyone out.
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
# Admin logins (JSON). The id is typed on the login page; codes go to this email and WhatsApp number.
ADMINS=[{"id":"GCI_ADMIN_NAME","name":"Your Name","email":"you@example.com","mobile":"9999999999"}]

# ---------- login codes: at least one of email or WhatsApp ----------
# Email (Brevo, free 300/day) ... or use RESEND_API_KEY instead
BREVO_API_KEY=
# RESEND_API_KEY=
MAIL_FROM=info@gurucomputerinstitute.com

# WhatsApp Cloud API (Meta) with an approved AUTHENTICATION template
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_OTP_TEMPLATE=gci_login_otp
WA_OTP_LANG=en
# WA_OTP_BUTTON=0   # only if the template has no "Copy code" button

# ---------- Cloudinary: student documents (private) and course pictures (public) ----------
CLOUDINARY_CLOUD_NAME=dlm14evj4
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- already set in wrangler.jsonc (override only if needed) ----------
# SITE_URL=https://www.gurucomputerinstitute.com
# MONGODB_DB=GuruComputerWebsite
# STUDENT_ID_PREFIX=GCI2022
# MAIL_FROM_NAME=Guru Computer Institute
# Extra origins allowed to call the API from a browser (comma separated), e.g. a local test site
# ALLOWED_ORIGINS=http://localhost:8787
# Local testing only: shows the login code on screen. NEVER set this on the live site.
# DEV_SHOW_OTP=1
